{
  "name": "codexpro",
  "version": "0.30.2",
  "description": "Local MCP server that connects ChatGPT Plugins to explicitly allowed repos on your machine.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebel0789/codexpro.git"
  },
  "bugs": {
    "url": "https://github.com/rebel0789/codexpro/issues"
  },
  "homepage": "https://rebel0789.github.io/codexpro/",
  "contributors": [
    {
      "name": "yuczzzzz",
      "url": "https://github.com/yuczzzzz"
    }
  ],
  "keywords": [
    "mcp",
    "chatgpt",
    "codex",
    "apps-sdk",
    "codexpro",
    "local-development",
    "cloudflare-tunnel",
    "ngrok",
    "tailscale"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs/index.html",
    "docs/zh.html",
    "docs/styles.css",
    "docs/script.js",
    "docs/favicon.svg",
    "docs/og.svg",
    "docs/star.svg",
    "docs/images",
    "docs/research-feedback.md",
    "docs/vm.md",
    "docs/vm-ai-usage.md",
    "scripts",
    "README.md",
    "README_ZH.md",
    "ROADMAP.md",
    "PUBLIC_LAUNCH_CHECKLIST.md",
    "DOMAIN_SETUP.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CONTRIBUTORS.md",
    "FAQ.md",
    "FAQ_ZH.md",
    "CHANGELOG.md",
    "CHATGPT_PROMPT.md",
    "CODEX_PROMPT.md",
    "AGENTS.example.md",
    "config.example.env"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codexpro": "scripts/codexpro.mjs",
    "codexpro-mcp": "dist/stdio.js",
    "codexpro-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run smoke",
    "vm:guest:smoke": "npm run build && node scripts/vm-guest-smoke.mjs",
    "vm:hyperv:smoke": "npm run build && node scripts/hyperv-smoke.mjs",
    "vm:hyperv:integration": "npm run build && node scripts/hyperv-integration.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release-guard.mjs",
    "start": "node dist/stdio.js",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "smoke": "node scripts/research-smoke.mjs && node scripts/tool-result-smoke.mjs && node scripts/platform-smoke.mjs && node scripts/vm-smoke.mjs && node scripts/vm-guest-smoke.mjs && node scripts/hyperv-smoke.mjs && node scripts/analysis-smoke.mjs && node scripts/analysis-cli-smoke.mjs && node scripts/smoke.mjs && node scripts/skill-precedence-smoke.mjs && node scripts/import-smoke.mjs && node scripts/http-smoke.mjs && node scripts/widget-smoke.mjs && node scripts/pro-smoke.mjs && node scripts/doctor-smoke.mjs && node scripts/settings-smoke.mjs && node scripts/execute-handoff-smoke.mjs && node scripts/logging-smoke.mjs && node scripts/runtime-coordinator-smoke.mjs && node scripts/agent-harness-smoke.mjs && node scripts/chatgpt-browser-smoke.mjs && node scripts/chatgpt-subagent-project-smoke.mjs && node scripts/subagent-browser-coordination-smoke.mjs && node scripts/release-guard-smoke.mjs && node scripts/runtime-reuse-smoke.mjs",
    "agent-harness:smoke": "npm run build && node scripts/agent-harness-smoke.mjs",
    "stress": "npm run build && node scripts/stress.mjs",
    "browser:smoke": "npm run build && node scripts/browser-preview-smoke.mjs && node scripts/chatgpt-subagent-project-smoke.mjs && node scripts/chatgpt-project-ui-smoke.mjs && node scripts/subagent-browser-coordination-smoke.mjs",
    "analysis:smoke": "npm run build && node scripts/analysis-smoke.mjs",
    "analysis:cli-smoke": "npm run build && node scripts/analysis-cli-smoke.mjs",
    "doctor": "node scripts/codexpro.mjs doctor",
    "connect": "node scripts/codexpro.mjs",
    "connect:setup": "node scripts/codexpro.mjs setup",
    "connect:local": "node scripts/codexpro.mjs --tunnel none",
    "connect:cloudflare": "node scripts/codexpro.mjs --tunnel cloudflare",
    "connect:chatgpt": "node scripts/codexpro.mjs --tunnel cloudflare",
    "connect:stable": "node scripts/codexpro.mjs --tunnel cloudflare-named",
    "connect:ngrok": "node scripts/codexpro.mjs ngrok",
    "connect:tailscale": "node scripts/codexpro.mjs tailscale",
    "pro:bundle": "node scripts/pro-bundle.mjs",
    "pro:apply": "node scripts/pro-apply.mjs",
    "release:guard": "node scripts/release-guard.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "package:smoke": "node scripts/package-install-smoke.mjs",
    "release:check": "npm run release:guard && npm run build && npm run smoke && npm run stress && npm audit --audit-level=high && npm run release:pack && npm run package:smoke",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "minimatch": "^10.2.6",
    "patchright-core": "^1.63.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
